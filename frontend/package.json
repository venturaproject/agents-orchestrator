{
  "name": "crew-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../.env.local node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node app.js",
    "lint": "oxlint app components features lib tests vitest.config.mts && tsc --noEmit",
    "architecture:check": "depcruise app components features lib tests --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "^17.3.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "vitest": "^4.1.12"
  }
}
