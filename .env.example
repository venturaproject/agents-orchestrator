# Local development uses PostgreSQL in Docker on localhost:55433.
DATABASE_URL=postgresql://crew_local:change-me@127.0.0.1:55433/crew_local
LOCAL_PG_USER=crew_local
LOCAL_PG_PASSWORD=change-me
LOCAL_PG_DATABASE=crew_local
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Required for the real Orchestrator → Develop → Testing loop.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AGENT_WORKSPACE_ROOT=.agent-workspaces
