{
  "name": "agent-workbench",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:up && npm run db:migrate",
    "build": "next build",
    "start": "node app.js",
    "lint": "oxlint app lib tests vitest.config.mts && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose --env-file .env.local -f compose.db.yml up -d",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "deploy:serv00": "./scripts/deploy-serv00.sh"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "vitest": "^4.1.12"
  }
}
