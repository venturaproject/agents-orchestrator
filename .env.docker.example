# Copy to .env.docker. Keep LOCAL_PG_PASSWORD and DATABASE_URL passwords in sync.
LOCAL_PG_USER=crew_local
LOCAL_PG_PASSWORD=replace-with-a-local-password
LOCAL_PG_DATABASE=crew_local
LOCAL_PG_PORT=55433
DATABASE_URL=postgresql://crew_local:replace-with-a-local-password@postgres:5432/crew_local

AUTH_SECRET=replace-with-at-least-32-random-characters
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AGENT_WORKSPACE_ROOT=/app/.agent-workspaces
APP_PORT=8088
NEXT_PUBLIC_BACKEND_URL=
